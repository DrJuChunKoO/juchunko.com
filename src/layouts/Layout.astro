---
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";
import LanguagePrompt from "../components/LanguagePrompt.tsx";
const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content="#0c0a09" />
		<script is:inline>
			// The override is "light", "dark", or null (follow the system preference).
			const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

			const readOverride = () => {
				try {
					const value = localStorage.getItem("theme");
					return value === "light" || value === "dark" ? value : null;
				} catch {
					return null;
				}
			};

			let override = readOverride();

			const applyTheme = (doc = document) => {
				doc.documentElement.classList.toggle("dark", override ? override === "dark" : systemDark.matches);
				doc.querySelector('meta[name="color-scheme"]').content = override ?? "light dark";
				for (const meta of doc.querySelectorAll('meta[name="theme-color"]')) {
					const scheme = meta.dataset.scheme;
					meta.media = override ? (scheme === override ? "all" : "not all") : `(prefers-color-scheme: ${scheme})`;
				}
			};

			applyTheme();

			document.addEventListener("astro:before-swap", (event) => {
				applyTheme(event.newDocument);
			});

			systemDark.addEventListener("change", () => applyTheme());

			window.addEventListener("storage", (event) => {
				if (event.key !== "theme" && event.key !== null) {
					return;
				}
				override = readOverride();
				applyTheme();
			});

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) {
					return;
				}

				// Switch to the opposite of what is rendered; landing back on the system scheme clears the override.
				const target = document.documentElement.classList.contains("dark") ? "light" : "dark";
				const system = systemDark.matches ? "dark" : "light";
				override = target === system ? null : target;
				applyTheme();

				try {
					if (override) {
						localStorage.setItem("theme", override);
					} else {
						localStorage.removeItem("theme");
					}
				} catch {
					// The theme still applies for this page even when it cannot be persisted.
				}
			});
		</script>
		<link rel="icon" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="help" type="text/plain" href="/llms.txt" />
		<slot name="head" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100..900&family=TikTok+Sans:opsz,wght@12..36,300..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		{currentPath !== "/" && <LanguagePrompt currentUrl={Astro.url.href} client:only="react" />}
		<script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=GTM-M7WLQNGR"></script>
		<script type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			window.gtag = function gtag() {
				dataLayer.push(arguments);
			};
			gtag("js", new Date());

			gtag("config", "GTM-M7WLQNGR");
		</script>
	</body>
</html>
