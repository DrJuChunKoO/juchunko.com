---
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";
import LanguagePrompt from "../components/LanguagePrompt.tsx";
const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			const applyTheme = (doc = document) => {
				let storedTheme = null;

				try {
					storedTheme = localStorage.getItem("theme");
				} catch {
					// Ignore storage failures and fall back to system preference.
				}

				const dark = storedTheme === "dark" || (storedTheme !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
				doc.documentElement.classList.toggle("dark", dark);
				doc.documentElement.style.colorScheme = dark ? "dark" : "light";
			};

			applyTheme();

			document.addEventListener("astro:before-swap", (event) => {
				applyTheme(event.newDocument);
			});

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) {
					return;
				}

				const html = document.documentElement;
				const isDark = html.classList.toggle("dark");
				html.style.colorScheme = isDark ? "dark" : "light";

				try {
					localStorage.setItem("theme", isDark ? "dark" : "light");
				} catch {
					// Ignore storage failures.
				}
			});
		</script>
		<link rel="icon" href="/favicon.png" />
		<link rel="help" type="text/plain" href="/llms.txt" />
		<slot name="head" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100..900&family=TikTok+Sans:opsz,wght@12..36,300..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		{currentPath !== "/" && <LanguagePrompt currentUrl={Astro.url.href} client:only="react" />}
		<script type="module" src="https://unpkg.com/@splinetool/viewer@1.0.18/build/spline-viewer.js"></script>
		<script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=GTM-M7WLQNGR"></script>
		<script type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			window.gtag = function gtag() {
				dataLayer.push(arguments);
			};
			gtag("js", new Date());

			gtag("config", "GTM-M7WLQNGR");
		</script>
	</body>
</html>
