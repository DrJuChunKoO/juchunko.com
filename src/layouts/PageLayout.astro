---
import Layout from "./Layout.astro";
import Nav from "../components/Nav";
import Footer from "@/components/Footer.astro";
import BaseHead from "@/components/BaseHead.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { CollectionEntry } from "astro:content";
import Agent from "@/components/agent/Agent";
import { cn } from "@/lib/utils";
import { getPageTitles } from "@/lib/page-title";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export interface Props {
	post?: CollectionEntry<"fragment" | "manual" | "act">;
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	publishedTime?: string; // ISO date string
	articleSection?: string;
	articleTags?: string[];
}
const currentPath = Astro.url.pathname;
const { post, title, description, image, type, publishedTime, articleSection, articleTags } = Astro.props;
const { documentTitle, socialTitle } = getPageTitles({ title, postTitle: post?.data.title, siteTitle: t("site.title") });
const pageDescription = description || post?.data.description || t("home.description");
const pageImage = image || post?.data.image || "/favicon.png";
---

<Layout>
	<BaseHead
		title={documentTitle}
		socialTitle={socialTitle}
		description={pageDescription}
		image={pageImage}
		url={Astro.url.href}
		type={type}
		publishedTime={publishedTime}
		articleSection={articleSection}
		articleTags={articleTags}
		slot="head"
	/>

	<div class="flex min-h-svh w-screen flex-col">
		<Nav lang={lang} client:load />
		<div
			class={cn(
				"relative mx-auto w-full max-w-360 flex-1 rounded-t-2xl  py-10 md:max-w-[90vw] md:py-16",
				"pr-[max(env(safe-area-inset-right),1rem)] pl-[max(env(safe-area-inset-left),1rem)]",
				"md:pr-[max(env(safe-area-inset-right),2rem)] md:pl-[max(env(safe-area-inset-left),2rem)]",
			)}
		>
			<slot />
		</div>
		{currentPath !== "/" && <Agent client:only="react" lang={lang} />}
		<Footer />
	</div>

	<script>
		function applyScrollClasses() {
			const scrollTop = window.scrollY;
			const windowHeight = window.innerHeight;
			document.body.classList.toggle("scrolled", scrollTop > 0);
			document.body.classList.toggle("scrolled-full", scrollTop >= windowHeight / 2);
		}

		function initScrollClassHandling() {
			applyScrollClasses();
			window.addEventListener("scroll", applyScrollClasses, { passive: true });
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initScrollClassHandling, { once: true });
		} else {
			initScrollClassHandling();
		}

		window.addEventListener("pageshow", applyScrollClasses);
	</script>
</Layout>
