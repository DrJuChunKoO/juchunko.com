---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

import ThemeToggle from "./ThemeToggle.astro";
import SoicalLink from "./SoicalLink.astro";
import LanguageSelector from "./LanguageSelector";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import TablerBrandGithub from "./icon/TablerBrandGithub.astro";
import TablerBrandThreads from "./icon/TablerBrandThreads.astro";
import TablerBrandFacebook from "./icon/TablerBrandFacebook.astro";
import TablerBrandInstagram from "./icon/TablerBrandInstagram.astro";
import TablerBrandTiktok from "./icon/TablerBrandTiktok.astro";
import TablerBrandYoutube from "./icon/TablerBrandYoutube.astro";
import TablerBrandX from "./icon/TablerBrandX.astro";
---

<div class="border-border bg-background/75 fixed inset-x-0 top-0 z-40 w-full border-b backdrop-blur-xl print:hidden">
	<nav
		class="mx-auto flex h-16 max-w-[90rem] items-center justify-end gap-2 pr-[max(env(safe-area-inset-right),1.5rem)] pl-[max(env(safe-area-inset-left),1.5rem)] text-sm transition-all md:max-w-[90vw]"
	>
		<a
			class="hover:outline-primary/50 -m-1 flex items-center rounded-lg p-1 text-sm transition-opacity hover:opacity-80 hover:outline-2 hover:outline-offset-2 md:text-base ltr:mr-auto rtl:ml-auto"
			href={`/${lang}`}
		>
			<span class="text-foreground font-medium tracking-wide uppercase" id="site-title">{t("site.title")}</span>
		</a>
		<a
			href="https://blog.juchunko.com/"
			target="_blank"
			rel="noreferrer"
			class="hover:text-foreground hover:outline-primary/50 text-muted-foreground relative hidden rounded-lg p-1 text-sm whitespace-nowrap transition-colors duration-200 hover:outline-2 hover:outline-offset-2 md:inline-block"
			aria-current="false"
		>
			{t("nav.blog")}
		</a>
		<a
			href="https://transpal.juchunko.com/"
			target="_blank"
			rel="noreferrer"
			class="hover:text-foreground hover:outline-primary/50 text-muted-foreground relative hidden rounded-lg p-1 text-sm whitespace-nowrap transition-colors duration-200 hover:outline-2 hover:outline-offset-2 md:inline-block"
			aria-current="false"
		>
			{t("nav.transript")}
		</a>
		<a
			href="https://github.com/DrJuChunKoO/juchunko.com"
			target="_blank"
			rel="noreferrer"
			class="hover:outline-primary/50 text-muted-foreground hover:text-foreground hidden rounded-full p-1 transition-opacity hover:opacity-80 hover:outline-2 hover:outline-offset-2 md:inline-flex"
			title="GitHub repository for this site"
			aria-label="GitHub repository for this site"
		>
			<TablerBrandGithub class="size-6" />
		</a>
		<ThemeToggle />
		<button
			class="hover:outline-primary/50 text-muted-foreground hover:text-foreground inline-flex items-center justify-center rounded-lg p-2 transition-colors hover:outline-2 hover:outline-offset-2 md:hidden"
			type="button"
			data-menu-toggle
			aria-label="Open navigation menu"
			aria-controls="mobile-nav"
			aria-expanded="false"
		>
			<span class="sr-only">Open navigation menu</span>
			<span class="block h-4 w-5">
				<span class="mb-1 block h-0.5 w-full rounded-full bg-current"></span>
				<span class="mb-1 block h-0.5 w-full rounded-full bg-current"></span>
				<span class="block h-0.5 w-full rounded-full bg-current"></span>
			</span>
		</button>
	</nav>
	<div
		id="mobile-nav"
		class="nav-menu bg-background/95 text-foreground pointer-events-none fixed inset-0 z-50 flex flex-col px-8 pt-8 pb-12 opacity-0 backdrop-blur-xl transition-all duration-300 md:hidden"
		data-menu
		aria-hidden="true"
	>
		<div class="flex items-center justify-end">
			<button
				class="hover:outline-primary/50 text-muted-foreground hover:text-foreground hover:bg-muted relative inline-flex items-center justify-center rounded-full p-2 transition-colors hover:outline-2 hover:outline-offset-2"
				type="button"
				data-menu-close
				aria-label="Close navigation menu"
			>
				<span class="sr-only">Close navigation menu</span>
				<span class="block h-5 w-5">
					<span class="absolute inset-x-2 top-1/2 h-0.5 -translate-y-1/2 rotate-45 rounded-full bg-current"></span>
					<span class="absolute inset-x-2 top-1/2 h-0.5 -translate-y-1/2 -rotate-45 rounded-full bg-current"></span>
				</span>
			</button>
		</div>
		<div class="flex flex-1 flex-col justify-center gap-6 text-2xl font-medium">
			<a
				href="https://blog.juchunko.com/"
				target="_blank"
				rel="noreferrer"
				class="hover:text-foreground text-muted-foreground transition-colors"
			>
				{t("nav.blog")}
			</a>
			<a
				href="https://transpal.juchunko.com/"
				target="_blank"
				rel="noreferrer"
				class="hover:text-foreground text-muted-foreground transition-colors"
			>
				{t("nav.transript")}
			</a>
		</div>
		<div class="grid grid-cols-4 place-items-center gap-4">
			<SoicalLink href="https://github.com/DrJuChunKoO/juchunko.com" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandGithub className="size-6" />
			</SoicalLink>
			<SoicalLink href="https://fb.com/dr.juchunko/" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandFacebook className="size-6" />
			</SoicalLink>
			<SoicalLink href="https://instagr.am/dr.juchunko/" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandInstagram className="size-6" />
			</SoicalLink>
			<SoicalLink href="https://tiktok.com/@dr.juchunko" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandTiktok className="size-6" />
			</SoicalLink>
			<SoicalLink href="https://threads.net/@dr.juchunko" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandThreads className="size-6" />
			</SoicalLink>
			<SoicalLink href="https://youtube.com/@dr.juchunko" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandYoutube className="size-6" />
			</SoicalLink>
			<SoicalLink href="https://x.com/@dAAAb" className="flex aspect-square w-12 items-center justify-center">
				<TablerBrandX className="size-6" />
			</SoicalLink>
		</div>
		<div class="mt-6 flex flex-col items-center gap-4">
			<span class="bg-border h-px w-48"></span>
			<LanguageSelector client:only="react" />
		</div>
	</div>
</div>

<style is:global>
	body.nav-open {
		overflow: hidden;
	}
	.nav-menu[data-open="true"] {
		opacity: 1;
		pointer-events: auto;
	}
</style>

<script>
	const browserLang = navigator.language;
	const [, urlLang] = location.pathname.split("/");
	const lang = urlLang ? urlLang : browserLang.startsWith("zh") ? "zh-TW" : "en";
	const locale = {
		"zh-TW": {
			siteTitle: "科技立委葛如鈞．寶博士",
			blog: "部落格",
			transript: "逐字稿",
		},
		en: {
			siteTitle: "Ju Chun Ko",
			blog: "Blog",
			transript: "Transcript",
		},
	};

	// Update home link
	const homeLink = document.querySelector(`a[href="/${lang}"]`) as HTMLAnchorElement;
	if (homeLink && !window.location.pathname.includes(`/${lang}`)) {
		homeLink.href = `/${lang}`;
	}

	// Update translations
	const siteTitle = document.querySelector("#site-title");
	const links = {
		blog: document.querySelectorAll('a[href="https://blog.juchunko.com/"]'),
		transript: document.querySelectorAll('a[href="https://transpal.juchunko.com/"]'),
	};

	if (siteTitle) {
		siteTitle.textContent = locale[lang].siteTitle;
	}
	links.blog.forEach((link) => {
		link.textContent = locale[lang].blog;
	});
	links.transript.forEach((link) => {
		link.textContent = locale[lang].transript;
	});

	const menu = document.querySelector("[data-menu]");
	const toggle = document.querySelector("[data-menu-toggle]");
	const close = document.querySelector("[data-menu-close]");
	const setMenuState = (isOpen) => {
		if (!menu || !toggle) return;
		menu.setAttribute("data-open", String(isOpen));
		menu.setAttribute("aria-hidden", String(!isOpen));
		toggle.setAttribute("aria-expanded", String(isOpen));
		document.body.classList.toggle("nav-open", isOpen);
	};

	setMenuState(false);
	if (toggle) {
		toggle.addEventListener("click", () => {
			const isOpen = menu?.getAttribute("data-open") === "true";
			setMenuState(!isOpen);
		});
	}
	if (close) {
		close.addEventListener("click", () => setMenuState(false));
	}
	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setMenuState(false));
	});
</script>
