---
import { Download, ExternalLink } from "@lucide/astro";
import photos from "@/data/portrait-photos.json";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const totalSize = (photos.reduce((total, photo) => total + photo.bytes, 0) / 1_000_000).toFixed(1);
---

<div class="not-prose" data-photo-pack>
	<div class="mb-5 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
		<p class="text-muted-foreground text-sm leading-relaxed">
			{t("photos.description")}<br />
			<span class="text-xs">{photos.length} {t("photos.count")} · JPG · {totalSize} MB</span>
		</p>
		<button
			type="button"
			data-download-pack
			data-progress={t("photos.progress")}
			data-success={t("photos.success")}
			data-error={t("photos.error")}
			hidden
			class="bg-primary text-primary-foreground focus-visible:outline-primary/50 shrink-0 cursor-pointer items-center gap-2 rounded-lg px-4 py-3 text-sm font-medium transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-wait disabled:opacity-60"
		>
			<Download size={16} aria-hidden="true" />
			{t("photos.downloadAll")}
		</button>
	</div>
	<p data-download-status role="status" aria-live="polite" class="text-muted-foreground mb-4 text-sm empty:hidden"></p>
	<noscript><p class="text-muted-foreground mb-4 text-sm">{t("photos.noScript")}</p></noscript>
	<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
		{
			photos.map((photo) => (
				<div class="overflow-hidden rounded-lg border border-black/10 bg-gray-50 dark:border-white/10 dark:bg-white/5">
					<a
						href={photo.original}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${t(`photos.caption.${photo.id}`)} — ${t("photos.viewOriginal")}`}
						class="group focus-visible:outline-primary/50 relative block bg-gray-100 focus-visible:outline-2 focus-visible:-outline-offset-2 dark:bg-white/5"
					>
						<img
							src={photo.thumbnail}
							alt={t(`photos.alt.${photo.id}`)}
							width={photo.width}
							height={photo.height}
							loading="lazy"
							decoding="async"
							class="aspect-[4/5] w-full object-contain transition-opacity group-hover:opacity-90"
						/>
						<ExternalLink size={14} aria-hidden="true" class="absolute right-2 bottom-2 rounded-sm bg-white/80 p-0.5 text-black" />
					</a>
					<div class="p-3">
						<p class="text-sm font-medium">{t(`photos.caption.${photo.id}`)}</p>
						<p class="text-muted-foreground mt-1 text-[0.6875rem]">
							{photo.width} × {photo.height} · {(photo.bytes / 1_000_000).toFixed(1)} MB
						</p>
						<a
							href={photo.original}
							download={photo.filename}
							aria-label={`${t("photos.downloadOriginal")} — ${t(`photos.caption.${photo.id}`)}`}
							class="hover:bg-primary/5 focus-visible:outline-primary/50 mt-3 flex min-h-11 items-center justify-center gap-1.5 rounded-md border border-black/10 px-2 py-2 text-xs font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 dark:border-white/15"
						>
							<Download size={14} aria-hidden="true" />
							{t("photos.downloadOriginal")}
						</a>
					</div>
				</div>
			))
		}
	</div>
</div>

<script>
	import photos from "@/data/portrait-photos.json";

	for (const pack of document.querySelectorAll<HTMLElement>("[data-photo-pack]")) {
		const button = pack.querySelector<HTMLButtonElement>("[data-download-pack]");
		const status = pack.querySelector<HTMLElement>("[data-download-status]");
		if (!button || !status) continue;
		button.hidden = false;
		button.style.display = "inline-flex";
		button.addEventListener("click", async () => {
			button.disabled = true;
			const progress = (completed: number) => {
				status.textContent = button.dataset.progress!.replace("{completed}", String(completed)).replace("{total}", String(photos.length));
			};
			progress(0);
			try {
				const { createPortraitArchive } = await import("@/lib/portrait-download");
				const archive = await createPortraitArchive(progress);
				const url = URL.createObjectURL(new Blob([Uint8Array.from(archive).buffer], { type: "application/zip" }));
				const link = document.createElement("a");
				link.href = url;
				link.download = "ju-chun-ko-photo-pack.zip";
				document.body.append(link);
				link.click();
				link.remove();
				setTimeout(() => URL.revokeObjectURL(url), 60_000);
				status.textContent = button.dataset.success!;
			} catch (error) {
				console.error("Unable to download portrait photo pack", error);
				status.textContent = button.dataset.error!;
			} finally {
				button.disabled = false;
			}
		});
	}
</script>
