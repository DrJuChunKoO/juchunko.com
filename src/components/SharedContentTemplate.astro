---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { render } from "astro:content";
import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import CardLink from "@/components/CardLink.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import { contentIdMatchesLang, getSlugFromContentId } from "@/lib/content";

export type CategoryKey = "acts" | "manuals";

export interface Props {
	post: CollectionEntry<"fragment" | "manual" | "act">;
	categoryKey?: CategoryKey;
}

const { post, categoryKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(post);

// 決定目前文章所屬 collection 與對應列表
const currentCollection = post.collection; // "fragment" | "manual" | "act"
const allInCollection = (await getCollection(currentCollection))
	.filter((p) => contentIdMatchesLang(p.id, lang))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 找到目前文章索引
const currentId = post.id;
const index = allInCollection.findIndex((p) => p.id === currentId);

// 依照首頁排序（新->舊）：index-1 是較新（下一篇），index+1 是較舊（前一篇）
const nextPost = index > 0 ? allInCollection[index - 1] : null;
const prevPost = index >= 0 && index + 1 < allInCollection.length ? allInCollection[index + 1] : null;
/**
 * CardLink 需要 category 字串
 * 直接使用目前 collection 名稱，避免寫死映射，方便未來擴充新分類
 */
const categoryForCard: string = currentCollection;
const postSlug = getSlugFromContentId(post.id);
const shouldShowActSummary = currentCollection === "act" && postSlug;
const actSummaryLabels =
	lang === "zh-TW"
		? {
				heading: "議題摘要",
				problem: "目前的問題",
				changes: "我們做了哪些更動",
				impact: "對我有什麼影響",
			}
		: {
				heading: "Issue Summary",
				problem: "Current Problem",
				changes: "What We Changed",
				impact: "How This Affects Me",
			};

import { stripMarkdown } from "@/lib/utils";
const description = post.data.description || stripMarkdown(post.body).slice(0, 150) + (post.body.length > 150 ? "..." : "");

// Derive articleSection label for OG metadata
const collectionSectionMap: Record<string, string> = {
	act: lang === "zh-TW" ? "法案行動" : "Legislative Acts",
	manual: lang === "zh-TW" ? "寶博士使用說明" : "JC User Manual",
	fragment: lang === "zh-TW" ? "補充資料" : "Reference",
};
const articleSection = collectionSectionMap[currentCollection] ?? currentCollection;

// Build article tags from status (act only) for GEO signals
const articleTags: string[] = [];
if (post.collection === "act" && "status" in post.data && post.data.status) {
	articleTags.push(post.data.status);
}

// Article schema
const articleSchema = post.data.date
	? {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: post.data.title,
			description: description,
			datePublished: post.data.date.toISOString(),
			dateModified: post.data.date.toISOString(),
			inLanguage: lang,
			mainEntityOfPage: {
				"@type": "WebPage",
				"@id": Astro.url.href,
			},
			image: post.data.image
				? { "@type": "ImageObject", url: post.data.image }
				: { "@type": "ImageObject", url: "https://juchunko.com/favicon.png", width: 512, height: 512 },
			author: {
				"@type": "Person",
				name: "葛如鈞",
				alternateName: "Ju-Chun Ko",
				url: "https://juchunko.com/zh-TW/",
			},
			publisher: {
				"@type": "Person",
				name: "葛如鈞",
				alternateName: "Ju-Chun Ko",
				url: "https://juchunko.com/zh-TW/",
			},
			url: Astro.url.href,
			articleSection: articleSection,
		}
	: null;

// GEO: LegalDocument schema for act collection
const legalDocSchema =
	post.collection === "act" && post.data.date
		? {
				"@context": "https://schema.org",
				"@type": "GovernmentPermit",
				name: post.data.title,
				description: description,
				url: Astro.url.href,
				datePublished: post.data.date.toISOString(),
				inLanguage: lang,
				issuedBy: {
					"@type": "GovernmentOrganization",
					name: lang === "zh-TW" ? "中華民國立法院" : "Legislative Yuan, Republic of China (Taiwan)",
					url: "https://www.ly.gov.tw/",
				},
				legislationIdentifier: `juchunko-act-${post.id.replace(/^.*\//, "")}`,
				...("status" in post.data && post.data.status ? { legislationLegalValue: post.data.status } : {}),
			}
		: null;

// GEO: DefinedTermSet schema for the "keyword" fragment (dictionary page)
const definedTermSetSchema =
	post.collection === "fragment" && post.id.replace(/^.*\//, "") === "keyword"
		? {
				"@context": "https://schema.org",
				"@type": "DefinedTermSet",
				name: post.data.title,
				description: description,
				url: Astro.url.href,
				inLanguage: lang,
				author: {
					"@type": "Person",
					name: "葛如鈞",
					alternateName: "Ju-Chun Ko",
				},
			}
		: null;
---

<PageLayout
	post={post}
	description={description}
	type="article"
	publishedTime={post.data.date ? post.data.date.toISOString() : undefined}
	articleSection={articleSection}
	articleTags={articleTags.length > 0 ? articleTags : undefined}
>
	{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
	{legalDocSchema && <script type="application/ld+json" set:html={JSON.stringify(legalDocSchema)} />}
	{definedTermSetSchema && <script type="application/ld+json" set:html={JSON.stringify(definedTermSetSchema)} />}
	<span
		class="absolute top-0 right-8 hidden h-24 w-16 items-end justify-center rounded-b-xl bg-gradient-to-b from-gray-100 to-gray-200 p-3 text-4xl transition-all md:flex dark:from-white/10 dark:to-white/5"
		>{post.data.emoji}</span
	>
	<article class="prose prose-slate dark:prose-invert mx-auto max-w-3xl" id="content">
		{categoryKey && <p class="font-medium tracking-tight text-gray-500 opacity-75 dark:text-gray-400">{t(`cat.${categoryKey}`)}</p>}
		{
			shouldShowActSummary && (
				<section
					id="act-summary"
					class="not-prose my-8 rounded-lg border border-black/5 bg-gray-50 p-4 md:p-6 dark:border-white/10 dark:bg-white/5"
					data-lang={lang}
					data-slug={postSlug}
					hidden
				>
					<div class="mb-4 flex items-center justify-between gap-3 border-b border-black/5 pb-3 dark:border-white/10">
						<h2 class="m-0 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">{actSummaryLabels.heading}</h2>
					</div>
					<div class="grid gap-3 md:grid-cols-3">
						<div class="rounded-lg border border-black/5 bg-white p-4 dark:border-white/10 dark:bg-white/5">
							<h3 class="m-0 text-sm font-semibold text-gray-950 dark:text-white">{actSummaryLabels.problem}</h3>
							<p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300" data-summary-field="problem" />
						</div>
						<div class="rounded-lg border border-black/5 bg-white p-4 dark:border-white/10 dark:bg-white/5">
							<h3 class="m-0 text-sm font-semibold text-gray-950 dark:text-white">{actSummaryLabels.changes}</h3>
							<p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300" data-summary-field="changes" />
						</div>
						<div class="rounded-lg border border-black/5 bg-white p-4 dark:border-white/10 dark:bg-white/5">
							<h3 class="m-0 text-sm font-semibold text-gray-950 dark:text-white">{actSummaryLabels.impact}</h3>
							<p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300" data-summary-field="impact" />
						</div>
					</div>
				</section>
			)
		}
		<Content />
	</article>

	<ShareButtons title={post.data.title} url={Astro.url.href} lang={lang} />

	{
		(prevPost || nextPost) && (
			<div class="mx-auto mt-20 max-w-3xl border-t-2 border-black/5 py-6 dark:border-white/5">
				<h2 class="mb-3 text-xl font-semibold">{t("post.recommend")}</h2>
				<div class="grid grid-cols-2 gap-2">
					{nextPost && <CardLink post={nextPost} lang={lang} category={categoryForCard} headingLevel={3} />}
					{prevPost && <CardLink post={prevPost} lang={lang} category={categoryForCard} headingLevel={3} />}
				</div>
			</div>
		)
	}
</PageLayout>

<script>
	const summarySection = document.querySelector<HTMLElement>("#act-summary");

	if (summarySection) {
		const content = document.querySelector("#content");
		const firstHeading = content?.querySelector("h1");
		if (firstHeading) firstHeading.insertAdjacentElement("afterend", summarySection);

		const lang = summarySection.dataset.lang;
		const slug = summarySection.dataset.slug;

		const removeSummary = () => summarySection.remove();

		if (!lang || !slug) {
			removeSummary();
		} else {
			fetch(`/api/act-summary?lang=${encodeURIComponent(lang)}&slug=${encodeURIComponent(slug)}`)
				.then((response) => {
					if (!response.ok) throw new Error(`HTTP ${response.status}`);
					return response.json();
				})
				.then((payload) => {
					const summary = payload?.summary;
					if (!payload?.success || !summary?.problem || !summary?.changes || !summary?.impact) {
						removeSummary();
						return;
					}

					for (const field of ["problem", "changes", "impact"] as const) {
						const element = summarySection.querySelector(`[data-summary-field="${field}"]`);
						if (element) element.textContent = summary[field];
					}

					summarySection.hidden = false;
				})
				.catch(removeSummary);
		}
	}
</script>

<style is:global>
	#content table {
		display: block;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}
	#content table th,
	#content table td {
		min-width: 120px;
	}
</style>
