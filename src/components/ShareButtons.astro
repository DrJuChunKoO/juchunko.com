---
import { type Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import TablerBrandFacebook from "@/components/icon/TablerBrandFacebook.astro";
import TablerBrandX from "@/components/icon/TablerBrandX.astro";
import TablerBrandLine from "@/components/icon/TablerBrandLine.astro";
import TablerBrandThreads from "@/components/icon/TablerBrandThreads.astro";
import TablerLink from "@/components/icon/TablerLink.astro";

interface Props {
	title: string;
	url: string;
	lang: Lang;
}

const { title, url, lang } = Astro.props;
const t = useTranslations(lang);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shareLinks = [
	{
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
		label: "Facebook",
		Icon: TablerBrandFacebook,
	},
	{
		href: `https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
		label: "X",
		Icon: TablerBrandX,
	},
	{
		href: `https://social-plugins.line.me/lineit/share?url=${encodedUrl}`,
		label: "LINE",
		Icon: TablerBrandLine,
	},
	{
		href: `https://www.threads.net/intent/post?text=${encodedTitle}%0A${encodedUrl}`,
		label: "Threads",
		Icon: TablerBrandThreads,
	},
] as const;
---

<div class="mx-auto mt-16 max-w-3xl border-t-2 border-black/5 pt-6 dark:border-white/5">
	<p class="mb-3 text-sm font-semibold tracking-tight text-gray-500 dark:text-gray-400">{t("post.share")}</p>
	<div class="grid grid-cols-3 gap-3 md:flex md:flex-wrap">
		{
			shareLinks.map(({ href, label, Icon }) => (
				<a
					href={href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={label}
					class="bg-secondary text-secondary-foreground hover:bg-accent hover:text-accent-foreground focus-visible:outline-primary/50 inline-flex flex-col items-center gap-1.5 rounded-xl px-2 py-3 transition-[transform,background-color,color,box-shadow] hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:scale-105 motion-safe:active:scale-[0.97] md:w-20"
				>
					<Icon class="size-6" />
					<span class="text-xs font-medium">{label}</span>
				</a>
			))
		}
		<button
			type="button"
			data-copy-link
			data-copied-text={t("post.share.copied")}
			data-copy-failed-text={t("post.share.copyFailed")}
			class="bg-secondary text-secondary-foreground hover:bg-accent hover:text-accent-foreground focus-visible:outline-primary/50 inline-flex cursor-pointer flex-col items-center gap-1.5 rounded-xl px-2 py-3 transition-[transform,background-color,color,box-shadow] hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:scale-105 motion-safe:active:scale-[0.97] md:w-20"
		>
			<span data-copy-link-icon>
				<TablerLink class="size-6" />
			</span>
			<span data-copy-link-label class="text-xs font-medium">{t("post.share.copy")}</span>
			<span data-copy-link-status aria-live="polite" class="sr-only"></span>
		</button>
	</div>
</div>

<script>
	const checkSvg =
		'<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" class="size-6"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12l5 5l10-10"/></svg>';

	function fallbackCopy(text: string): boolean {
		try {
			const textarea = document.createElement("textarea");
			textarea.value = text;
			textarea.setAttribute("readonly", "");
			textarea.style.position = "fixed";
			textarea.style.opacity = "0";
			document.body.appendChild(textarea);
			textarea.select();
			const ok = document.execCommand("copy");
			textarea.remove();
			return ok;
		} catch {
			return false;
		}
	}

	document.querySelectorAll<HTMLElement>("[data-copy-link]").forEach((btn) => {
		const label = btn.querySelector<HTMLElement>("[data-copy-link-label]");
		const icon = btn.querySelector<HTMLElement>("[data-copy-link-icon]");
		const status = btn.querySelector<HTMLElement>("[data-copy-link-status]");
		const originalText = label?.textContent ?? "";
		const copiedText = btn.dataset.copiedText ?? "Copied";
		const failedText = btn.dataset.copyFailedText ?? "Copy failed";
		const originalSvg = icon?.innerHTML ?? "";
		let timeout: ReturnType<typeof setTimeout> | null = null;
		let clickSequence = 0;

		const reset = () => {
			if (timeout !== null) clearTimeout(timeout);
			timeout = null;
			if (icon) icon.innerHTML = originalSvg;
			if (label) label.textContent = originalText;
			if (status) status.textContent = "";
		};

		const showResult = (copied: boolean) => {
			if (icon) icon.innerHTML = copied ? checkSvg : originalSvg;
			const resultText = copied ? copiedText : failedText;
			if (label) label.textContent = resultText;
			if (status) status.textContent = resultText;
			if (timeout !== null) clearTimeout(timeout);
			timeout = setTimeout(reset, 1500);
		};

		btn.addEventListener("click", async () => {
			const currentClick = ++clickSequence;
			reset();
			const url = window.location.href;
			let copied = false;
			try {
				await navigator.clipboard.writeText(url);
				copied = true;
			} catch {
				copied = fallbackCopy(url);
			}
			if (currentClick !== clickSequence) return;
			showResult(copied);
		});
	});
</script>
