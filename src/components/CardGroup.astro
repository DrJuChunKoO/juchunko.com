---
import { Folder } from "lucide-react";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="bg-white dark:bg-transparent">
	<div class="flex items-center gap-3 border-b border-gray-200 bg-gray-50/80 px-4 py-3 sm:px-5 dark:border-white/10 dark:bg-white/5">
		<span
			class="flex size-8 shrink-0 items-center justify-center rounded-md border border-gray-200 bg-white dark:border-white/10 dark:bg-white/5"
		>
			<Folder aria-hidden="true" className="text-primary size-4" strokeWidth={1.75} />
		</span>
		<div class="text-sm font-semibold tracking-tight sm:text-base">{title}</div>
	</div>
	<div class="divide-y divide-gray-200 dark:divide-white/10">
		<slot />
	</div>
</section>
