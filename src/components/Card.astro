---
const { href, target = "_self", title } = Astro.props;
---

<a
	href={href}
	target={target}
	class="not-prose group hover:outline-primary/50 relative flex h-full flex-col gap-3 overflow-hidden rounded-lg bg-gray-50 p-4 transition-colors hover:bg-gray-100 hover:outline-2 hover:outline-offset-2 dark:bg-white/5 dark:hover:bg-white/10"
>
	<span
		class="bg-primary/5 text-primary flex size-10 items-center justify-center rounded-lg dark:bg-white/10 dark:text-white/80 [&_svg]:size-5"
	>
		<slot name="icon" />
	</span>
	<div class="min-w-0 flex-1">
		<div class="text-sm font-semibold md:text-base">{title}</div>
		<div class="text-muted-foreground mt-2 text-sm leading-relaxed [&_p]:m-0">
			<slot />
		</div>
	</div>
</a>
