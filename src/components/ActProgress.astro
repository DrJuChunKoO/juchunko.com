---
interface Props {
	label: string;
	value: number;
	status: string;
}

const { label, value, status } = Astro.props;
const normalizedValue = Math.min(100, Math.max(0, value));
---

<div class="not-prose my-6 rounded-lg border border-black/5 bg-gray-50 p-4 dark:border-white/10 dark:bg-white/5">
	<div class="mb-2 flex items-center justify-between gap-3 text-sm font-medium text-gray-900 dark:text-white">
		<span>{label}</span>
		<span class="text-gray-500 dark:text-gray-400">{normalizedValue}%</span>
	</div>
	<div class="mb-2 h-2 w-full rounded-full bg-gray-200 dark:bg-gray-700">
		<div class="h-2 rounded-full bg-gray-900 dark:bg-white" style={`width: ${normalizedValue}%`}></div>
	</div>
	<p class="m-0 text-sm leading-6 text-gray-500 dark:text-gray-400">{status}</p>
</div>
