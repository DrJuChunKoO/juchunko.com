---
import PageLayout from "../layouts/PageLayout.astro";
import { ArrowRight } from "@lucide/astro";
import ParticleOrb from "@/components/ParticleOrb.tsx";
---

<PageLayout>
	<div class="relative mx-auto aspect-square w-full max-w-3xl sm:aspect-video">
		<ParticleOrb client:only="react" />

		<div class="pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-center gap-2">
			<h1 class="text-center text-xl font-semibold tracking-wide uppercase sm:text-3xl lg:text-4xl">The Plurality is here.</h1>
			<p class="text-xl font-medium md:text-2xl" data-lang="title">先進國會・共識未來</p>
		</div>
	</div>
	<div class="flex flex-col items-center justify-center gap-4 text-center">
		<a
			href="/zh-TW"
			class="bg-primary text-primary-foreground hover:bg-primary/90 active:bg-primary/80 group hover:outline-primary/50 flex w-max items-center justify-center gap-2 rounded-full px-6 py-3 tracking-tight transition-colors hover:outline-2 hover:outline-offset-2"
			data-lang="button"
		>
			<span data-lang="buttonText"> 進入「科技立委葛如鈞．寶博士」宇宙 </span>
			<ArrowRight class="size-5 animate-pulse transition-transform group-hover:translate-x-1" />
		</a>
	</div>
</PageLayout>
<script>
	type Locale = "zh-TW" | "en";
	type MessageKey = "title" | "buttonText";

	const lang: Locale = navigator.language.startsWith("zh") ? "zh-TW" : "en";
	const locale: Record<Locale, Record<MessageKey, string>> = {
		"zh-TW": {
			title: "先進國會・共識未來",
			buttonText: "進入「科技立委葛如鈞．寶博士」宇宙",
		},
		en: {
			title: "Emerging Congress, Converging Consensus",
			buttonText: "Enter Dr.Ju-Chun KO Universe",
		},
	};

	document.querySelector('[data-lang="button"]')?.setAttribute("href", `/${lang}`);
	document.querySelectorAll("[data-lang]").forEach((el) => {
		const key = el.getAttribute("data-lang");
		if (key === "title" || key === "buttonText") {
			el.textContent = locale[lang][key];
		}
	});
</script>
