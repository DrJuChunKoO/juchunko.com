---
import { type CollectionEntry, getCollection } from "astro:content";
import SharedContentTemplate from "@/components/SharedContentTemplate.astro";
import { getRouteLangFromContentId, getSlugFromContentId } from "@/lib/content";
export async function getStaticPaths() {
	const acts = await getCollection("manual");
	return acts
		.map((act) => {
			const lang = getRouteLangFromContentId(act.id);
			const slug = getSlugFromContentId(act.id);
			if (!lang || !slug) return;

			return {
				params: { lang, slug },
				props: act,
			};
		})
		.filter(Boolean);
}
type Props = CollectionEntry<"manual">;
const post = Astro.props;
---

<SharedContentTemplate post={post} categoryKey="manuals" />
