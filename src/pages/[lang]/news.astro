---
import PageLayout from "../../layouts/PageLayout.astro";
import { useTranslations } from "../../i18n/utils";
import { languages } from "../../i18n/ui";
import NewsPage from "../../components/NewsPage";
import { contentIdMatchesLang, getSlugFromContentId } from "@/lib/content";
import { getCollection } from "astro:content";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang },
	}));
}

const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "zh-TW");

const title = t("home.news.title");
const description = t("home.news.subtitle");
const relatedPages = Object.fromEntries(
	(await getCollection("act"))
		.filter((post) => contentIdMatchesLang(post.id, lang as "en" | "zh-TW"))
		.flatMap((post) => post.data.newsTopicIds.map((topicId) => [topicId, `/${lang}/act/${getSlugFromContentId(post.id)}`])),
);
---

<PageLayout {title} {description}>
	<div class="container mx-auto max-w-5xl md:px-4">
		<header class="mb-10 border-b border-black/10 pb-8 sm:mb-12 sm:pb-10 dark:border-white/10">
			<div class="mb-5 flex items-center gap-3 text-xs font-semibold tracking-[0.16em] text-gray-500 uppercase dark:text-gray-400">
				<span>{t("newsPage.topics.label")}</span>
				<span class="h-px flex-1 bg-black/10 dark:bg-white/10"></span>
			</div>
			<div class="grid items-end gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(15rem,24rem)] sm:gap-10">
				<h1 class="text-4xl leading-none font-semibold tracking-[-0.045em] text-gray-950 sm:text-6xl dark:text-white">
					{t("home.news.title")}
				</h1>
				<p class="text-sm leading-6 text-gray-500 sm:pb-1 sm:text-base dark:text-gray-400">{t("home.news.subtitle")}</p>
			</div>
		</header>

		<NewsPage client:only="react" lang={lang as "en" | "zh-TW"} {relatedPages} />
	</div>
</PageLayout>
