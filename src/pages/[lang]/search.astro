---
import SearchPage from "@/components/SearchPage";
import { languages } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/PageLayout.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang },
	}));
}

const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "zh-TW");

const title = t("search.title");
const description = t("search.description");
---

<PageLayout {title} {description}>
	<div class="container mx-auto max-w-3xl md:px-4">
		<div class="prose prose-slate dark:prose-invert mx-auto mb-6 max-w-full">
			<p class="font-medium tracking-tight text-gray-500 opacity-75 dark:text-gray-400">{description}</p>
			<h1>{title}</h1>
		</div>
		<span
			class="absolute top-0 right-8 hidden h-24 w-16 items-end justify-center rounded-b-xl bg-linear-to-b from-gray-100 to-gray-200 p-3 text-4xl transition-all md:flex dark:from-white/10 dark:to-white/5"
			>🔎</span
		>

		<SearchPage client:only="react" lang={lang as "en" | "zh-TW"} />
	</div>
</PageLayout>
