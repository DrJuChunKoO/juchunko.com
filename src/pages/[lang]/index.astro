---
import PageLayout from "../../layouts/PageLayout.astro";
import CardLink from "@/components/CardLink.astro";
import HomeFeeds from "@/components/HomeFeeds.tsx";
import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import { getCollection } from "astro:content";
import { ArrowRight } from "@lucide/astro";
import { getFeaturedAchievementSummary, getHomepageCopy, selectFeaturedEntries } from "@/lib/homepage";
import { contentIdMatchesLang } from "@/lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const copy = getHomepageCopy(lang);

export function getStaticPaths() {
	return [{ params: { lang: "en" } }, { params: { lang: "zh-TW" } }];
}

const acts = (await getCollection("act"))
	.filter((post) => contentIdMatchesLang(post.id, lang))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const manuals = (await getCollection("manual"))
	.filter((post) => contentIdMatchesLang(post.id, lang))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fragments = (await getCollection("fragment"))
	.filter((post) => contentIdMatchesLang(post.id, lang))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredActs = selectFeaturedEntries(acts);
---

<PageLayout title={copy.seo.title} description={t("home.description")}>
	<div class="mb-6 flex flex-col gap-4 md:mb-8">
		<div class="w-full max-w-3xl">
			<p class="text-muted-foreground text-xs font-semibold uppercase">{copy.hero.eyebrow}</p>
			<h1 class="text-foreground my-2 text-2xl leading-[1.35em] font-bold md:text-4xl">{copy.hero.title}</h1>
			<p class="text-muted-foreground leading-[1.7em] md:text-xl">{copy.hero.summary}</p>
		</div>
		<div class="flex flex-wrap gap-3">
			<a
				href={copy.hero.primaryCta.href}
				class="bg-primary text-primary-foreground hover:bg-primary/90 active:bg-primary/80 group hover:outline-primary/50 inline-flex w-max items-center justify-center gap-1.5 rounded-full px-4 py-2 text-sm tracking-tight transition-colors hover:outline-2 hover:outline-offset-2 md:gap-2 md:px-6 md:py-3 md:text-base"
			>
				{copy.hero.primaryCta.label}
				<ArrowRight class="size-4 transition-transform group-hover:translate-x-1 md:size-5" />
			</a>
			<a
				href={copy.hero.secondaryCta.href}
				class="hover:outline-primary/50 group border-border bg-card hover:bg-muted/50 inline-flex w-max items-center justify-center gap-1.5 rounded-full border px-4 py-2 text-sm tracking-tight transition-colors hover:outline-2 hover:outline-offset-2 md:gap-2 md:px-6 md:py-3 md:text-base"
			>
				{copy.hero.secondaryCta.label}
				<ArrowRight class="size-4 transition-transform group-hover:translate-x-1 md:size-5" />
			</a>
		</div>
	</div>

	<section id="achievements" class="mb-12 scroll-mt-24 space-y-6 md:scroll-mt-28">
		<h2 class="text-foreground mt-2 text-2xl font-bold md:text-3xl">{copy.sectionTitles.achievements}</h2>
		<div class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 md:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] md:gap-6">
			{
				featuredActs.map((post) => (
					<CardLink
						post={post}
						lang={lang}
						category="act"
						showDescription
						description={getFeaturedAchievementSummary(post.id, lang)}
						headingLevel={3}
					/>
				))
			}
		</div>
	</section>

	<section id="issues" class="mb-12 scroll-mt-24 space-y-6 md:scroll-mt-28">
		<h2 class="text-foreground mt-2 text-2xl font-bold md:text-3xl">{copy.sectionTitles.issues}</h2>
		<div class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 md:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] md:gap-6">
			{acts.map((post) => <CardLink post={post} lang={lang} category="act" headingLevel={3} />)}
		</div>
	</section>

	<section id="updates" class="mb-12 scroll-mt-24 space-y-6 md:scroll-mt-28">
		<h2 class="text-foreground mt-2 text-2xl font-bold md:text-3xl">{copy.sectionTitles.updates}</h2>

		<HomeFeeds lang={lang} headingLevel={3} client:visible />
	</section>

	<section id="reading" class="scroll-mt-24 space-y-10 md:scroll-mt-28">
		<h2 class="text-foreground mt-2 text-2xl font-bold md:text-3xl">{copy.sectionTitles.reading}</h2>
		<div class="space-y-8">
			<div class="space-y-4">
				<h3 class="text-foreground text-xl font-semibold">{copy.sectionTitles.manuals}</h3>
				<div class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 md:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] md:gap-6">
					{manuals.map((post) => <CardLink post={post} lang={lang} category="manual" headingLevel={4} />)}
				</div>
			</div>

			<div class="space-y-4">
				<h3 class="text-foreground text-xl font-semibold">{copy.sectionTitles.fragments}</h3>
				<div class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 md:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] md:gap-6">
					{fragments.map((post) => <CardLink post={post} lang={lang} category="fragment" headingLevel={4} />)}
				</div>
			</div>
		</div>
	</section>
</PageLayout>
